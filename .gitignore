# ============================================
# ChartRunner Dev Kit — Collaboration Safety
# ============================================
# The dev-kit is a private research cockpit. These rules protect the
# production game + keep collaborator work from polluting git history.

# Never commit wild experiments or large test data
dev-kit/experiments/**
!dev-kit/experiments/README.md

# Private seeds, historical exports, Umbrel dumps (often large)
dev-kit/seeds/**
!dev-kit/seeds/README.md

# Generated production patches (owner reviews before manual application)
dev-kit/patches/**
!dev-kit/patches/README.md

# Personal research notes (owner + each collaborator keeps their own)
dev-kit/notes/**
!dev-kit/notes/README.md

# Per-collaborator / per-machine local state (worktrees + local overrides)
dev-kit/.local/**
dev-kit/coworker-*/**
dev-kit/*.local.*

# Temporary bridge copies or injected scripts during pairing
dev-kit/bridge.local.js
dev-kit/bridge.*.js

# Umbrel connection configs (contain real IPs, Tailscale addresses, ports)
dev-kit/umbrel/*.local.*
dev-kit/umbrel/config.*
!dev-kit/umbrel/README.md

# Session recordings, replays, backtest artifacts (can be huge)
dev-kit/recordings/**
dev-kit/replays/**

# Local dev server state or PID files
dev-kit/.serve.pid
dev-kit/*.log

# Private ops / local-only research surfaces
dev-kit/
local-max/
sdk-m1-scaffold/
chartrunner-prototype/sdk/
*_preview.html
*.bak*
*.backup*
COACH_IMAGE_INSTRUCTIONS.md
coach.jpg
data/market-data-replays/
