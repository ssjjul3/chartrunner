cd /Users/julianroy/projects/chartrunner

# Paste the IDL into the file (overwrites the old one)
pbpaste > anchor/target/idl/chartrunner_registry.json

# Verify it's the post-patch IDL (must include ScoreTooHigh)
python3 -c "
import json
idl = json.load(open('anchor/target/idl/chartrunner_registry.json'))
err_names = [e['name'] for e in idl.get('errors', [])]
print('errors in IDL:', err_names)
assert 'ScoreTooHigh' in err_names, 'STALE — paste did not work, re-copy from Playground'
print('✓ post-patch IDL confirmed')
print(f'IDL size: {len(open(\"anchor/target/idl/chartrunner_registry.json\").read()):,} bytes')
"

# Stage + commit + push (this also pushes the lib.rs commit from before)
git add anchor/target/idl/chartrunner_registry.json
git commit -m "anchor: re-export registry IDL post-security-patch (3 new error variants)

ScoreTooHigh / SharpeOutOfRange / DurationTooLong added to chartrunner_registry
after the security-audit upgrade. JS client (crRegistry.recordRun) needs the
fresh IDL to surface these errors when caps are hit."

git push